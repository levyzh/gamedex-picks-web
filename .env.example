# Copy this file to `.env` and fill in real values. Vite only exposes vars that
# start with VITE_ to the browser. Restart `npm run dev` after any change here.

# Supabase project URL and publishable key — the SAME project as the main
# Gamedex app, which is what makes "log in with your Gamedex account" work.
# Safe to ship: RLS is the real protection, not secrecy.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here

# The Gamedex Picks API (the Python service). Not deployed yet, so local.
VITE_PICKS_API_URL=http://localhost:8000

# Where the main Gamedex app lives. Only used for the "create an account"
# link — signing up belongs over there, not here.
VITE_GAMEDEX_WEB_URL=http://localhost:5173
